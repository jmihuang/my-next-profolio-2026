{
  "name": "next-js-first-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "d1:migrate:local": "wrangler d1 migrations apply jamie-portfolio-products --local",
    "d1:verify:local": "wrangler d1 execute jamie-portfolio-products --local --command \"SELECT 'products' AS table_name, COUNT(*) AS row_count FROM products UNION ALL SELECT 'product_images', COUNT(*) FROM product_images UNION ALL SELECT 'product_sections', COUNT(*) FROM product_sections;\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/x-data-grid": "^9.12.0",
    "@mui/x-date-pickers": "^9.12.0",
    "@opennextjs/cloudflare": "^1.13.1",
    "@tinymce/tinymce-react": "^5.1.1",
    "antd": "^5.20.6",
    "argon2": "^0.45.1",
    "better-sqlite3": "^11.3.0",
    "dayjs": "^1.11.23",
    "formidable": "^3.5.1",
    "next": "14.2.7",
    "next-auth": "^5.0.0-beta.32",
    "react": "^18",
    "react-dom": "^18",
    "react-router-dom": "^6.27.0",
    "slugify": "^1.6.6",
    "xss": "^1.0.15",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "eslint": "^8",
    "eslint-config-next": "14.2.7",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "wrangler": "^4.49.1"
  }
}
